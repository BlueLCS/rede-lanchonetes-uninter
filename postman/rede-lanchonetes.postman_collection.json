              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"T01 - Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"T01 - Tokens retornados\", function () {",
                  "  pm.expect(response.accessToken).to.be.a(\"string\");",
                  "  pm.expect(response.refreshToken).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"adminToken\", response.accessToken);",
                  "pm.collectionVariables.set(\"adminRefreshToken\", response.refreshToken);"
                ]
