                  "pm.test(\"T04 - Canal e status corretos\", function () {",
                  "  response.items.forEach(function (order) {",
                  "    pm.expect(order.canalPedido).to.eql(\"TOTEM\");",
                  "    pm.expect(order.status).to.eql(\"PAGAMENTO_APROVADO\");",
