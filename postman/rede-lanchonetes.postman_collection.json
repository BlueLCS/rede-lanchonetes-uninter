    {
      "name": "Produtos",
      "item": [
        {
          "name": "T02 - Consultar cardápio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"T02 - Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test(\"T02 - Cardápio possui produtos\", function () {",
                  "  pm.expect(response.items).to.be.an(\"array\");",
                  "  pm.expect(response.items.length).to.be.above(0);",
                  "});",
                  "",
                  "const firstProduct = response.items[0];",
                  "pm.collectionVariables.set(\"produtoId\", firstProduct.produtoId);",
                  "const deniedProduct = response.items.find(function (product) {",
                  "  return product.nome === \"X-Burger\";",
                  "}) || firstProduct;",
                  "pm.collectionVariables.set(\"produtoPagamentoNegadoId\", deniedProduct.produtoId);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/unidades/{{unidadeId}}/cardapio"
          }
        },
        {
          "name": "T08 - Cliente tenta cadastrar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"T08 - Status HTTP 403\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
