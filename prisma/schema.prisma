generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoUnidade {
  MATRIZ
  FRANQUIA
}

enum PerfilUsuario {
  ADMIN
  GERENTE
  ATENDENTE
  COZINHA
  CLIENTE
}

enum CanalPedido {
  APP
  WEB
  TOTEM
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_APROVADO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  RESERVA
  SAIDA
  ESTORNO
  AJUSTE
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_FIXO
}

enum TipoMovimentacaoPontos {
  CREDITO
  RESGATE
  ESTORNO
  AJUSTE
}

model Unidade {
  id                 String           @id @default(uuid()) @db.Uuid
  unidadeMatrizId    String?          @map("unidade_matriz_id") @db.Uuid
  nome               String           @db.VarChar(120)
  tipo               TipoUnidade
  logradouro         String           @db.VarChar(150)
  numero             String           @db.VarChar(20)
  bairro             String           @db.VarChar(100)
  cidade             String           @db.VarChar(100)
  uf                 String           @db.Char(2)
  cep                String           @db.VarChar(9)
  ativo              Boolean          @default(true)
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  unidadeMatriz      Unidade?         @relation("MatrizUnidades", fields: [unidadeMatrizId], references: [id], onDelete: Restrict)
  unidadesVinculadas Unidade[]        @relation("MatrizUnidades")
  usuarios           Usuario[]
  produtosUnidade    ProdutoUnidade[]
  estoques           Estoque[]
  pedidos            Pedido[]
  promocoes          Promocao[]

  @@index([unidadeMatrizId])
  @@map("unidades")
}

model Usuario {
  id                   String                  @id @default(uuid()) @db.Uuid
  unidadeId            String?                 @map("unidade_id") @db.Uuid
  nome                 String                  @db.VarChar(120)
  email                String                  @unique @db.VarChar(150)
  senhaHash            String                  @map("senha_hash") @db.VarChar(255)
  perfil               PerfilUsuario           @default(CLIENTE)
  ativo                Boolean                 @default(true)
  criadoEm             DateTime                @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime                @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  unidade              Unidade?                @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  sessoesRefresh       SessaoRefresh[]
  pedidos              Pedido[]
  historicosStatus     HistoricoStatusPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]
  consentimentos       ConsentimentoLgpd[]
  contaFidelidade      ContaFidelidade?
  logsAuditoria        LogAuditoria[]

  @@index([unidadeId])
  @@index([perfil])
  @@map("usuarios")
}

model SessaoRefresh {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadoEm DateTime? @map("revogado_em") @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes_refresh")
}

model Produto {
  id              String           @id @default(uuid()) @db.Uuid
  nome            String           @db.VarChar(120)
  descricao       String?          @db.VarChar(500)
  categoria       String           @db.VarChar(60)
  ativo           Boolean          @default(true)
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  produtosUnidade ProdutoUnidade[]
  estoques        Estoque[]
  itensPedido     ItemPedido[]

  @@index([nome])
  @@index([categoria])
  @@map("produtos")
}

model ProdutoUnidade {
  id           String   @id @default(uuid()) @db.Uuid
  unidadeId    String   @map("unidade_id") @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  preco        Decimal  @db.Decimal(10, 2)
  disponivel   Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  unidade      Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([unidadeId, produtoId])
  @@index([produtoId])
  @@map("produtos_unidade")
}

model Estoque {
  id                   String                @id @default(uuid()) @db.Uuid
  unidadeId            String                @map("unidade_id") @db.Uuid
  produtoId            String                @map("produto_id") @db.Uuid
  quantidadeDisponivel Int                   @default(0) @map("quantidade_disponivel")
  quantidadeReservada  Int                   @default(0) @map("quantidade_reservada")
  criadoEm             DateTime              @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  unidade              Unidade               @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  produto              Produto               @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  movimentacoes        MovimentacaoEstoque[]

  @@unique([unidadeId, produtoId])
  @@index([produtoId])
  @@map("estoques")
}

model MovimentacaoEstoque {
  id             String                  @id @default(uuid()) @db.Uuid
  estoqueId      String                  @map("estoque_id") @db.Uuid
  pedidoId       String?                 @map("pedido_id") @db.Uuid
  usuarioId      String?                 @map("usuario_id") @db.Uuid
  tipo           TipoMovimentacaoEstoque
  quantidade     Int
  saldoAnterior  Int                     @map("saldo_anterior")
  saldoPosterior Int                     @map("saldo_posterior")
  motivo         String?                 @db.VarChar(255)
  criadoEm       DateTime                @default(now()) @map("criado_em") @db.Timestamptz(3)
  estoque        Estoque                 @relation(fields: [estoqueId], references: [id], onDelete: Restrict)
  pedido         Pedido?                 @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuario        Usuario?                @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([estoqueId])
  @@index([pedidoId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("movimentacoes_estoque")
}

model Pedido {
  id                   String                  @id @default(uuid()) @db.Uuid
  clienteId            String                  @map("cliente_id") @db.Uuid
  unidadeId            String                  @map("unidade_id") @db.Uuid
  promocaoId           String?                 @map("promocao_id") @db.Uuid
  canalPedido          CanalPedido             @map("canal_pedido")
  status               StatusPedido            @default(AGUARDANDO_PAGAMENTO)
  formaPagamento       String                  @default("MOCK") @map("forma_pagamento") @db.VarChar(20)
  subtotal             Decimal                 @db.Decimal(10, 2)
  desconto             Decimal                 @default(0) @db.Decimal(10, 2)
  valorTotal           Decimal                 @map("valor_total") @db.Decimal(10, 2)
  canceladoEm          DateTime?               @map("cancelado_em") @db.Timestamptz(3)
  entregueEm           DateTime?               @map("entregue_em") @db.Timestamptz(3)
  criadoEm             DateTime                @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime                @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  cliente              Usuario                 @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  unidade              Unidade                 @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  promocao             Promocao?               @relation(fields: [promocaoId], references: [id], onDelete: SetNull)
  itens                ItemPedido[]
  historicosStatus     HistoricoStatusPedido[]
  pagamento            Pagamento?
  movimentacoesEstoque MovimentacaoEstoque[]
  movimentacoesPontos  MovimentacaoPontos[]

  @@index([clienteId])
  @@index([unidadeId])
  @@index([promocaoId])
  @@index([canalPedido])
  @@index([status])
  @@index([criadoEm])
  @@map("pedidos")
}

model ItemPedido {
  id            String   @id @default(uuid()) @db.Uuid
  pedidoId      String   @map("pedido_id") @db.Uuid
  produtoId     String   @map("produto_id") @db.Uuid
  quantidade    Int
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  subtotal      Decimal  @db.Decimal(10, 2)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, produtoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

model HistoricoStatusPedido {
  id             String        @id @default(uuid()) @db.Uuid
  pedidoId       String        @map("pedido_id") @db.Uuid
  usuarioId      String?       @map("usuario_id") @db.Uuid
  statusAnterior StatusPedido? @map("status_anterior")
  statusNovo     StatusPedido  @map("status_novo")
  motivo         String?       @db.VarChar(255)
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  pedido         Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("historicos_status_pedido")
}

model Pagamento {
  id                 String          @id @default(uuid()) @db.Uuid
  pedidoId           String          @unique @map("pedido_id") @db.Uuid
  provedor           String          @default("MOCK") @db.VarChar(30)
  status             StatusPagamento @default(PENDENTE)
  valor              Decimal         @db.Decimal(10, 2)
  transacaoExternaId String?         @map("transacao_externa_id") @db.VarChar(100)
  payloadEnvio       Json            @map("payload_envio") @db.JsonB
  payloadRetorno     Json?           @map("payload_retorno") @db.JsonB
  criadoEm           DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  pedido             Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("pagamentos")
}

model ConsentimentoLgpd {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  finalidade   String   @db.VarChar(100)
  aceito       Boolean
  versaoTermo  String   @map("versao_termo") @db.VarChar(20)
  ip           String?  @db.VarChar(45)
  registradoEm DateTime @default(now()) @map("registrado_em") @db.Timestamptz(3)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, finalidade])
  @@index([registradoEm])
  @@map("consentimentos_lgpd")
}

model ContaFidelidade {
  id            String               @id @default(uuid()) @db.Uuid
  usuarioId     String               @unique @map("usuario_id") @db.Uuid
  saldoPontos   Int                  @default(0) @map("saldo_pontos")
  criadoEm      DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  usuario       Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  movimentacoes MovimentacaoPontos[]

  @@map("contas_fidelidade")
}

model MovimentacaoPontos {
  id             String                 @id @default(uuid()) @db.Uuid
  contaId        String                 @map("conta_id") @db.Uuid
  pedidoId       String?                @map("pedido_id") @db.Uuid
  tipo           TipoMovimentacaoPontos
  pontos         Int
  saldoAnterior  Int                    @map("saldo_anterior")
  saldoPosterior Int                    @map("saldo_posterior")
  descricao      String?                @db.VarChar(255)
  criadoEm       DateTime               @default(now()) @map("criado_em") @db.Timestamptz(3)
  conta          ContaFidelidade        @relation(fields: [contaId], references: [id], onDelete: Restrict)
  pedido         Pedido?                @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([contaId])
  @@index([pedidoId])
  @@index([criadoEm])
  @@map("movimentacoes_pontos")
}

model Promocao {
  id           String       @id @default(uuid()) @db.Uuid
  unidadeId    String?      @map("unidade_id") @db.Uuid
  nome         String       @db.VarChar(120)
  descricao    String?      @db.VarChar(500)
  tipoDesconto TipoDesconto @map("tipo_desconto")
  valor        Decimal      @db.Decimal(10, 2)
  valorMinimo  Decimal?     @map("valor_minimo") @db.Decimal(10, 2)
  dataInicio   DateTime     @map("data_inicio") @db.Timestamptz(3)
  dataFim      DateTime     @map("data_fim") @db.Timestamptz(3)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  unidade      Unidade?     @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  pedidos      Pedido[]

  @@index([unidadeId])
  @@index([dataInicio, dataFim])
  @@map("promocoes")
}

model LogAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  requestId  String?  @map("request_id") @db.VarChar(100)
  acao       String   @db.VarChar(100)
  entidade   String   @db.VarChar(100)
  entidadeId String?  @map("entidade_id") @db.VarChar(100)
  dados      Json?    @db.JsonB
  ip         String?  @db.VarChar(45)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([requestId])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("logs_auditoria")
}
